{
  // ============================================================
  //  CURRENT SETTINGS - Zed live config (2026-08)
  //  Grouped for readability. Applied verbatim to Zed.
  //  Portable only: no fonts, no absolute paths, no OS keys.
  // ============================================================

  //! Workbench & window
  "theme": "One Dark",                              // UI theme
  "icon_theme": "Zed (Default)",                    // file icon set
  "ui_font_size": 15,                               // UI font size
  "buffer_font_size": 14,                           // editor font size
  "relative_line_numbers": false,                   // absolute line numbers
  "soft_wrap": "editor_width",                      // wrap at editor width
  "scroll_beyond_last_line": "off",                 // stop scrolling at EOF
  "tab_size": 2,                                    // indent width
  "hard_tabs": false,                               // spaces, not tabs

  //! Editor behavior
  "format_on_save": "on",                           // format on save
  "autosave": "after_delay",                        // autosave after inactivity
  "cursor_blink": true,                             // blink the cursor
  "highlight_selected_word": true,                  // highlight matching words
  "show_whitespaces": "selection",                  // whitespace while selecting
  "use_autoclose": true,                            // auto-close brackets/quotes
  "restore_on_startup": "last_session",             // reopen the last session

  //! Files & git
  "file_scan_exclusions": [                         // skip in search/index
    "**/.git",
    "**/node_modules",
    "**/dist"
  ],
  "git": { "inline_blame": { "enabled": false } },  // no inline git blame

  //! Terminal
  "terminal": { "blinking": "terminal_controlled" },// terminal cursor blink

  //! Telemetry
  "telemetry": {                                    // no telemetry
    "diagnostics": false,
    "metrics": false
  },

  //! Extensions (syncode-managed via the dashboard picker)
  "auto_install_extensions": {}
}
